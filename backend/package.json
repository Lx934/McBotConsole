{
  "name": "mc-bot-backend",
  "version": "7.0.0",
  "main": "index.js",
  "bin": "index.js",
  "private": true,
  "scripts": {
    "start": "node index.js"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "names.txt",
      "node_modules/minecraft-data/**/*",
      "node_modules/minecraft-protocol/src/**/*",
      "node_modules/mineflayer/lib/**/*",
      "node_modules/socks-proxy-agent/**/*",
      "node_modules/https-proxy-agent/**/*"
    ],
    "scripts": [
      "node_modules/minecraft-protocol/src/**/*.js",
      "node_modules/mineflayer/lib/**/*.js"
    ]
  },
  "dependencies": {
    "mineflayer": "^4.20.0",
    "archiver": "^6.0.1",
    "socks-proxy-agent": "^8.0.2",
    "https-proxy-agent": "^7.0.2"
  }
}